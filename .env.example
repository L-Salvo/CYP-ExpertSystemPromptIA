# =============================================================
# Plantilla de variables de entorno para Docker Compose
# Copiar a `.env` y completar:   cp .env.example .env
# El archivo `.env` NO debe comitearse.
# =============================================================

# ---- PostgreSQL ----
POSTGRES_DB=expert_prompts
POSTGRES_USER=expert_user
POSTGRES_PASSWORD=cambiar_esta_password

# ---- Backend ----
# Prolog e IA en mock en esta base (PASO 20). En el próximo paso,
# tras agregar el servicio prolog, poner PROLOG_MOCK=false.
PROLOG_MOCK=true
PROLOG_SERVICE_BASE_URL=http://prolog:8081
AI_MOCK=true
